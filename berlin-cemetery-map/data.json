   "address": "Großgörschenstraße 12-14, 10829 Berlin",
   "founded": 1856,
   "hectares": 4.6,
   "graveNote": "Parish cemetery of the St Matthew congregation",
   "travelMin": 25,
   "travelText": "S-Bahn or U-Bahn towards Yorckstraße, get out at Yorckstraße (Großgörschenstraße), then a 3 minute walk. About 25 minutes door to gate.",
   "hoursKind": "seasonal-daily",
   "hoursText": "Daily from 08:00. Closing moves with the month: 16:00 in January and December, 20:00 from May to August.",
   "need": 60,
   "seeIt": "The friendliest of the five, and the only one with a café in it. Jacob and Wilhelm Grimm lie side by side under two small plain stones that most visitors walk past. Rudolf Virchow, who worked out cellular pathology and also built Berlin's sewers, is a few rows away.",
   "graves": [
    "Jacob and Wilhelm Grimm",
    "Rudolf Virchow",
    "Rio Reiser",
    "May Ayim"
   ],
   "practical": "Café Finovo is inside the grounds and serves normal coffee and cake, which sounds odd and works. The memorial to the 20 July 1944 plotters and the denk mal positHIV AIDS memorial are both on the site.",
   "verdict": "Best if you want the visit to feel like an afternoon rather than a duty.",
   "short": "St.-Matthäus"
  }
