 "sites": [
  {
   "id": "grosse-hamburger",
   "name": "Alter Jüdischer Friedhof",
   "sub": "Große Hamburger Straße, Mitte",
   "lat": 52.5246,
   "lon": 13.3994,
   "address": "Große Hamburger Straße 26, 10115 Berlin",
   "founded": 1672,
   "hectares": 0.4,
   "graveNote": "Between 3,000 and 12,000 burials before 1827",
   "travelMin": 11,
   "travelText": "About 11 minutes on foot from Alexanderplatz, or one S-Bahn stop to Hackescher Markt and a 4 minute walk.",
   "hoursKind": "open-access",
   "hoursText": "Open ground, free, no gate to time. Go in daylight.",
   "need": 45,
   "seeIt": "Berlin's first Jewish cemetery is now almost empty ground. The Gestapo had trenches cut through it in 1943 and the headstones broken up, so what you walk on is a lawn with a handful of recovered stones set along one edge.",
   "graves": [
    "Moses Mendelssohn (replica stone, set 1990)"
   ],
   "practical": "Will Lammert's sculpture of Jewish victims of fascism stands by the entrance, on the site of the old people's home the Gestapo used as a deportation collection point. The Anne Frank Zentrum and the Otto Weidt workshop museum are on the same street.",
   "verdict": "The one to see if you only have half an hour and you are already in Mitte.",
   "short": "Große Hamburger Str."
  },
  {
   "id": "dorotheenstadt",
   "name": "Dorotheenstädtischer Friedhof",
   "sub": "Chausseestraße, Mitte",
   "lat": 52.5288,
   "lon": 13.3849,
   "address": "Chausseestraße 126, 10115 Berlin",
   "founded": 1762,
   "hectares": 1.7,
   "graveNote": "1.7 hectares, listed as a historic monument",
   "travelMin": 16,
   "travelText": "S-Bahn from Alexanderplatz to Friedrichstraße, U6 north to Naturkundemuseum, then a 4 minute walk. About 16 minutes door to gate.",
   "hoursKind": "seasonal-daily",
   "hoursText": "Daily from 08:00. Closing moves with the month: 16:00 in January and December, 20:00 from May to August.",
   "need": 60,
   "seeIt": "The densest hour of Berlin cultural history you can walk. Hegel and Fichte lie a few metres apart, Schinkel and Schadow and Rauch designed half of the city centre you just walked through, and Brecht and Helene Weigel are under two plain field stones near the front wall.",
   "graves": [
    "G. W. F. Hegel",
    "Johann Gottlieb Fichte",
    "Karl Friedrich Schinkel",
    "Bertolt Brecht and Helene Weigel",
    "Heinrich Mann",
    "Anna Seghers",
    "Herbert Marcuse",
    "Ernst Litfaß"
   ],
   "practical": "The Brecht-Weigel house sits at the cemetery entrance at Chausseestraße 125, so the grave and the flat are the same stop. Two more cemeteries, the French Huguenot one and St Hedwig's, share the same block.",
   "verdict": "The best single choice if you want names you recognise and a short trip.",
   "short": "Dorotheenstadt"
  },
  {
   "id": "invaliden",
   "name": "Invalidenfriedhof",
   "sub": "Scharnhorststraße, Mitte",
   "lat": 52.5321,
   "lon": 13.3722,
   "address": "Scharnhorststraße 31, 10115 Berlin",
   "founded": 1748,
   "hectares": 2.4,
   "graveNote": "About 3,000 graves in 1961, more than 90 percent later cleared",
   "travelMin": 19,
   "travelText": "S-Bahn to Friedrichstraße, U6 to Schwartzkopffstraße, then a 6 minute walk. About 19 minutes door to gate.",
   "hoursKind": "invaliden",
   "hoursText": "Daily. April to September 07:00 to 19:00, October to March 09:00 to 16:00.",
   "need": 45,
   "seeIt": "A Prussian military cemetery that the Berlin Wall ran straight through. More than nine graves in ten were cleared to make room for the death strip, guard towers and the dog run, and the emptiness is the exhibit. A surviving stretch of the border wall still stands along the canal edge.",
   "graves": [
    "Gerhard von Scharnhorst (tomb designed by Schinkel, sculpted by Rauch, 1834)"
   ],
   "practical": "Come at the Scharnhorststraße gate rather than trying the canal side. Pair it with the Berlin Wall Memorial on Bernauer Straße, which is two U6 stops further north.",
   "verdict": "Pick this if the Wall is what you actually came to Berlin for.",
   "short": "Invalidenfriedhof"
  },
  {
   "id": "weissensee",
   "name": "Jüdischer Friedhof Weißensee",
   "sub": "Herbert-Baum-Straße, Pankow",
   "lat": 52.5449,
   "lon": 13.4578,
   "address": "Herbert-Baum-Straße 45, 13088 Berlin",
   "founded": 1880,
   "hectares": 40,
   "graveNote": "More than 115,000 burials, the largest preserved Jewish cemetery in Europe",
   "travelMin": 24,
   "travelText": "Tram M4 from Alexanderplatz/Memhardstraße straight to Albertinenstraße, about 17 minutes, then a 7 minute walk. No changes.",
   "hoursKind": "weissensee",
   "hoursText": "Closed Saturdays and on holidays. April to September Mon to Thu 07:30 to 17:00, Fri 07:30 to 14:30, Sun 08:00 to 17:00. October to March it closes an hour earlier on Mon to Thu and Sun.",
   "need": 90,
   "seeIt": "Forty hectares of forest that happens to be a cemetery. It survived the Nazi period nearly intact, which nowhere else in Jewish Berlin did, so you are looking at an unbroken record of the community that lived here: merchant dynasties, art nouveau mausoleums, the Fischer and Mosse publishing families, and 90 Torah scrolls buried after Kristallnacht.",
   "graves": [
    "Lesser Ury",
    "Samuel Fischer",
    "Rudolf Mosse",
    "Herbert Baum resistance group memorial"
   ],
   "practical": "Men must cover their heads. Kippot are lent at the entrance, so you do not need to bring anything. Take the free map at the gate, because the grid is genuinely large enough to get lost in.",
   "verdict": "The one worth building an afternoon around. Do not try to squeeze it in.",
   "short": "Weißensee"
  },
  {
   "id": "matthaeus",
   "name": "Alter St.-Matthäus-Kirchhof",
   "sub": "Großgörschenstraße, Schöneberg",
   "lat": 52.491,
