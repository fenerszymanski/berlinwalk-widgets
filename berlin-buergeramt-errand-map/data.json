{"source":"Berlin ServicePortal (service.berlin.de): Bürgeramt location pages and service pages","checked":"2026-09-20","totals":{"offices":38,"walkIn":26,"districts":12},"errands":[{"id":"meldebescheinigung","label":"Registration certificate (Meldebescheinigung)","online":"Free, with an activated eID and a BundID login","onlineFee":"0 EUR","counterFee":"10 EUR at the counter, plus 5 EUR for each extra family member on the same sheet","door":"walkin","deadline":null,"wait":"Issued on the spot","note":"The same sheet your bank, your school or your employer asks for. Online it is free; the counter charges ten euros for it."},{"id":"fuehrungszeugnis","label":"Police clearance certificate (Führungszeugnis)","online":"Yes, with an activated eID","onlineFee":"13 EUR","counterFee":"13 EUR","door":"walkin","deadline":null,"wait":"Posted to you, usually within about two weeks","note":"Same price either way, so the only question is whether you spend a morning on it. From 14 years old."},{"id":"pin","label":"Activate the eID or reset the PIN","online":"No, this one has to be done in person","onlineFee":null,"counterFee":"Free","door":"walkin","deadline":null,"wait":"Done while you wait","note":"This is the visit that pays for itself. It works on a German ID card, an EU eID-Karte and an electronic residence permit."},{"id":"abholen","label":"Collect a finished ID card or passport","online":"No","onlineFee":null,"counterFee":"Free","door":"collect","deadline":null,"wait":"Over the counter","note":"No appointment anywhere, but only at the office where you applied. Pick the office you can reach twice."},{"id":"anmeldung","label":"Register or re-register your address (Anmeldung / Ummeldung)","online":"Only if you are 18 or over, German or an EU citizen, with BundID and an activated eID","onlineFee":"0 EUR","counterFee":"Free","door":"appointment","deadline":"14 days after you move in","wait":"Confirmation printed at the counter","note":"Missing the 14 days is an Ordnungswidrigkeit under the federal registration act, with a fine of up to 1,000 euros. Bring the Wohnungsgeberbestätigung."},{"id":"personalausweis","label":"New German ID card (Personalausweis)","online":"No, fingerprints are taken in person","onlineFee":null,"counterFee":"46 EUR from 24, 27.60 EUR under 24, plus 6 EUR if the office takes the photo","door":"appointment","deadline":null,"wait":"About 3 to 4 weeks","note":"Since 1 May 2025 the biometric photo has to be produced digitally at the office or a certified studio. Paper prints are not accepted."},{"id":"reisepass","label":"New German passport (Reisepass)","online":"No","onlineFee":null,"counterFee":"70 EUR from 24, 37.50 EUR under 24, plus 32 EUR express and 6 EUR for the photo","door":"appointment","deadline":null,"wait":"Up to 8 weeks, or about 4 working days on express","note":"Express only holds if the application is in before 11:00. A provisional passport costs 26 EUR and is handed over the same day."},{"id":"eidkarte","label":"eID card for EU and EEA citizens (Unionsbürgerkarte)","online":"No","onlineFee":null,"counterFee":"37 EUR, no exemptions","door":"appointment","deadline":null,"wait":"About 3 to 4 weeks","note":"The card that gives an EU citizen without a German ID the same online door. From 16, and you have to be registered in Berlin."},{"id":"abmeldung","label":"Deregister a flat (Abmeldung)","online":"No online route on the Berlin page, but it can be sent in writing","onlineFee":null,"counterFee":"Free","door":"post","deadline":"From 7 days before the move to 14 days after","wait":"Confirmation sent back to you","note":"You only deregister when you leave Germany or give up one of several flats. Moving within Berlin is a re-registration, not a deregistration."},{"id":"sperre","label":"Block your address from advertisers (Übermittlungssperre)","online":"Yes, with BundID and an activated eID","onlineFee":"0 EUR","counterFee":"Free","door":"online","deadline":null,"wait":"Recorded in the register","note":"Stops the register handing your address to address traders and political parties. Free, and almost nobody does it."},{"id":"auskunft","label":"Look up someone in the register (Melderegisterauskunft)","online":"Yes","onlineFee":"5 EUR","counterFee":"10 EUR","door":"appointment","deadline":null,"wait":"Answer sent to you","note":"Half price online. The fee is charged even when the search finds nothing."},{"id":"beglaubigung","label":"Certified copy or signature (Beglaubigung)","online":"No","onlineFee":null,"counterFee":"5 EUR per page, 5 EUR for a signature","door":"appointment","deadline":null,"wait":"Done at the counter","note":"Not on the walk-in list, so this one still costs you a slot."}],"offices":[{"n":"Heerstraße","d":"Charlottenburg-Wilmersdorf","a":"Heerstr. 12, 14052","lat":52.50938,"lon":13.26766,"w":1,"h":{"Mo":"09:00-13:30, 14:30-18:00","Di":"09:00-18:00","Mi":"08:00-15:30","Do":"08:00-14:30","Fr":"08:00-13:00"},"late":"18:00","lateDay":"Mo","early":"08:00","earlyDay":"Mi"},{"n":"Hohenzollerndamm","d":"Charlottenburg-Wilmersdorf","a":"Hohenzollerndamm 177, 10713","lat":52.48937,"lon":13.31224,"w":1,"h":{"Mo":"09:30-18:00","Di":"09:00-18:00","Mi":"08:00-15:30","Do":"08:00-14:30","Fr":"08:00-13:00"},"late":"18:00","lateDay":"Mo","early":"08:00","earlyDay":"Mi"},{"n":"Wilmersdorfer Straße","d":"Charlottenburg-Wilmersdorf","a":"Wilmersdorfer Straße 46, 10627","lat":52.50968,"lon":13.3055,"w":1,"h":{"Mo":"09:00-13:30, 14:30-18:00","Di":"09:00-18:00","Mi":"08:00-15:30","Do":"08:00-14:30","Fr":"08:00-13:00"},"late":"18:00","lateDay":"Mo","early":"08:00","earlyDay":"Mi"},{"n":"Kreuzberg, Yorckstraße","d":"Friedrichshain-Kreuzberg","a":"Yorckstraße 4-11, 10965","lat":52.49378,"lon":13.38529,"w":0,"h":{"Mo":"08:00-12:00, 13:00-18:00","Di":"08:00-12:00, 13:00-18:00","Mi":"08:00-15:00","Do":"08:00-14:00","Fr":"08:00-13:00","Sa":"09:00-13:00"},"late":"18:00","lateDay":"Mo","early":"08:00","earlyDay":"Mo"},{"n":"Friedrichshain, Frankfurter Allee","d":"Friedrichshain-Kreuzbe