 "steps": [
  {
   "t": "The official grade",
   "cols": [
    "grade"
   ],
   "cap": "All 39 official bathing sites carry the top EU classification. It is worked out after the season ends from 40 results per site from the last four bathing seasons, and it measures two things only: Escherichia coli and intestinal enterococci. Read as a ranking, this board says nothing at all."
  },
  {
   "t": "What the grade leaves out",
   "cols": [
    "grade",
    "algae"
   ],
   "cap": "30 of the 39 sites are flagged for possible blue-green algae mass growth. Berlin regulation keeps algae out of the classification and has it assessed separately, so a site can hold the top grade and a bloom on the same afternoon. Blooms build from July."
  },
  {
   "t": "The itch and the weed",
   "cols": [
    "algae",
    "itch",
    "weed"
   ],
   "cap": "14 sites carry a cercariae note, the itch that comes from waterfowl by way of shoreline snails. It swarms once the water first passes 20 degrees and can return after a long warm spell. 17 sites carry a water-plant note. Only 1 of the 39 has none of the three."
  },
  {
   "t": "Who is watching, and what is there",
   "cols": [
    "rescue",
    "boat",
    "wc",
    "step",
    "dogs"
   ],
   "cap": "Water rescue is listed at 29 sites and always as present at times, never all day. 10 sites list none. 24 are not screened from boat traffic. 10 have no toilet, 5 are step-free to the water, and 38 of 39 forbid dogs outright."
  },
  {
   "t": "After 15 September",
   "cols": [
    "algae",
    "itch",
    "weed",
    "rescue",
    "boat",
    "wc",
    "step",
    "dogs"
   ],
   "cap": "Sampling stops on 15 September and the published assessment stops with it. Nothing on this board changes: the flags describe the site, not the week. What ends is the measurement, so from the 16th your own eyes at the shore are the instrument."
  }
 ],
